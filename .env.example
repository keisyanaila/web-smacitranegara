# Salin file ini menjadi .env.local lalu isi nilainya.
# .env.local TIDAK ikut ke git (lihat .gitignore). Di Vercel, isi variabel yang
# sama di Project Settings → Environment Variables.

# Connection string Neon (https://console.neon.tech → project → Connect).
# Setelah diisi, jalankan db/schema.sql sekali di Neon SQL Editor.
# Kalau kosong, situs tetap jalan dengan data contoh, tapi admin tidak bisa menyimpan.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# Password untuk masuk ke /admin. Pakai yang panjang & acak.
ADMIN_PASSWORD="ganti-dengan-password-yang-kuat"
